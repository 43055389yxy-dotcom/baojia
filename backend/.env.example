APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:3000"]
# Private server-to-server credential for the AstraQuote MCP aggregator.
# Generate a long random value and configure the same value in the MCP stack.
ASTRAQUOTE_MCP_INTERNAL_TOKEN=

# Primary AI provider. Bedrock Mantle uses an OpenAI-compatible endpoint.
AI_PROVIDER=bedrock
BEDROCK_API_KEY=
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MODEL=zai.glm-4.7-flash
# Final-review component edits always use this single stable model.
COMPONENT_REVISION_MODEL=deepseek.v3.2
COMPONENT_REVISION_TIMEOUT_SECONDS=30

# Optional legacy fallback provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# boto3 default credential chain: prefer IAM Role or AWS_PROFILE.
# Final quote delivery. Keep the bucket private; the service returns a stable AstraQuote URL.
ASTRAQUOTE_XLSX_BUCKET=
ASTRAQUOTE_XLSX_REGION=
ASTRAQUOTE_XLSX_PREFIX=quotes
ASTRAQUOTE_XLSX_URL_TTL_SECONDS=604800
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
AWS_PRICING_REGION=us-east-1

# Google Cloud Billing Catalog API requires an API key. AWS uses the configured
# AWS credentials. Azure Retail Prices and OCI public list prices need no key.
GCP_BILLING_API_KEY=
# Maximum duration of one customer-answer recheck before the original draft is restored.
CONFIRMATION_REPROCESSING_TIMEOUT_SECONDS=300
# First-pass AI cleaning: hedge independent routes, then retry transient
# timeout/network/429/5xx failures once. These do not enable local parsing.
INTAKE_AI_HEDGE_DELAY_SECONDS=4
INTAKE_AI_PRIMARY_TIMEOUT_SECONDS=16
INTAKE_AI_RECOVERY_TIMEOUT_SECONDS=14
INTAKE_AI_RETRY_TIMEOUT_SECONDS=35
INTAKE_AI_RETRY_DELAY_SECONDS=1
