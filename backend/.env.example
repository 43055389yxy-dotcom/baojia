APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:3000"]

# Primary AI provider. Bedrock Mantle uses an OpenAI-compatible endpoint.
AI_PROVIDER=bedrock
BEDROCK_API_KEY=
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MODEL=zai.glm-4.7-flash

# Optional legacy fallback provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# boto3 default credential chain: prefer IAM Role or AWS_PROFILE.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
AWS_PRICING_REGION=us-east-1

# Comma-separated, dedicated BCM Workload Estimate IDs.
BCM_WORKLOAD_ESTIMATE_IDS=
BCM_ALLOW_ESTIMATE_CREATE=true
BCM_RATE_TYPE=BEFORE_DISCOUNTS
BCM_POLL_INTERVAL_SECONDS=1.0
BCM_POLL_TIMEOUT_SECONDS=30
# Optional browser fallback. Normal quotes do not depend on it.
CALCULATOR_ENABLED=false
