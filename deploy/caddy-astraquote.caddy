baojia.tontianit.com {
    encode zstd gzip

    @astraquote_oauth {
        path /mcp /oauth/* /.well-known/oauth-authorization-server /.well-known/openid-configuration /.well-known/oauth-protected-resource*
    }
    handle @astraquote_oauth {
        reverse_proxy astraquote:8001
    }

    @astraquote_downloads {
        path /downloads/*
    }
    handle @astraquote_downloads {
        reverse_proxy astraquote:8200
    }

    handle {
        respond "AstraQuote MCP 4.2.0" 200
    }
}
