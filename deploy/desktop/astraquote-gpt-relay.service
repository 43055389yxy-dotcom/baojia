[Unit]
Description=AstraQuote Codex Chat desktop quote relay
After=network-online.target docker.service vncserver@:1.service
Wants=network-online.target
Requires=docker.service vncserver@:1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/astraquote/source
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/ec2-user/.Xauthority
Environment=PYTHONPATH=/home/ec2-user/astraquote/source/backend
Environment=ASTRAQUOTE_GPT_RELAY_DIR=/home/ec2-user/astraquote/data/gpt-relay
Environment=ASTRAQUOTE_RELAY_ENGINE=chatgpt
Environment=ASTRAQUOTE_GPT_RELAY_STATE=/home/ec2-user/astraquote/data/gpt-relay/browser-state.json
Environment=ASTRAQUOTE_V2_STATE_DIR=/home/ec2-user/astraquote/data/v2-quotes
Environment=ASTRAQUOTE_CODEX_CONTAINER=astraquote-chatgpt-desktop
Environment=ASTRAQUOTE_CODEX_CDP=http://127.0.0.1:9222
ExecStartPre=/usr/bin/docker inspect astraquote-chatgpt-desktop
ExecStartPre=/usr/bin/docker start astraquote-chatgpt-desktop
ExecStart=/home/ec2-user/astraquote/gpt-relay-venv/bin/python /home/ec2-user/astraquote/source/tools/gpt_quote_relay_worker.py
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
