[Unit]
Description=AstraQuote ChatGPT browser quote relay
After=network-online.target vncserver@:1.service
Wants=network-online.target
Requires=vncserver@:1.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/astraquote/source
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/ec2-user/.Xauthority
Environment=PYTHONPATH=/home/ec2-user/astraquote/source/backend
Environment=ASTRAQUOTE_GPT_RELAY_DIR=/home/ec2-user/astraquote/data/gpt-relay
Environment=ASTRAQUOTE_GPT_RELAY_STATE=/home/ec2-user/astraquote/data/gpt-relay/browser-state.json
Environment=ASTRAQUOTE_FIREFOX_PROFILE=/home/ec2-user/.mozilla/firefox/z97ytnft.default-default
Environment=ASTRAQUOTE_CHATGPT_PROJECT=baojia
Environment=ASTRAQUOTE_CHATGPT_URL=https://chatgpt.com/projects
ExecStart=/home/ec2-user/astraquote/gpt-relay-venv/bin/python /home/ec2-user/astraquote/source/tools/gpt_quote_relay_worker.py
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
